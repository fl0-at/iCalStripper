{
  "name": "i-cal-stripper",
  "version": "0.9.3",
  "description": "iCal Stripper",
  "main": "build/main.js",
  "scripts": {
    "compile": "tsc",
    "prepare-build": "npm run copystuff && npm run copystyles",
    "copystuff": "copyfiles -e \"./*.ts\" -e \"./tsconfig.json\" -e \"./*.sln\" -e \"./*.njsproj\" \"./*.*\" \"./build\"",
    "copystyles": "copyfiles \"./css/**\" \"./build\" && copyfiles \"./fonts/**\" \"./build\"",
    "build-win": "tsc && npm run copystuff && npm run copystyles && electron-builder --win",
    "build-win-portable": "tsc && npm run copystuff && npm run copystyles && electron-builder --win=portable",
    "build-linux": "tsc && npm run copystuff && npm run copystyles && electron-builder --linux",
    "build-mac": "tsc && npm run copystuff && npm run copystyles && electron-builder --mac",
    "publish-win": "tsc && npm run copystuff && npm run copystyles && electron-builder --win -p always"
  },
  "keywords": [
    "iCal",
    "JSON",
    "stripper",
    "editor"
  ],
  "author": {
    "name": "fl0-at",
    "email": "florianjohannesloeffler@gmail.com"
  },
  "license": "CCO-1.0",
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "copyfiles": "^2.4.1",
    "electron": "^23.1.3",
    "electron-builder": "^23.6.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "air-datepicker": "^3.3.5",
    "console-log-json": "^2.9.0",
    "electron-updater": "^5.3.0",
    "ical-toolkit": "^1.0.9",
    "random-words": "^1.2.0"
  },
  "build": {
    "appId": "at.fl0.iCalStripper",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "./build/*",
      "./build/css/*",
      "./build/fonts/**"
    ],
    "productName": "iCalStripper",
    "publish": [
      {
        "provider": "github",
        "owner": "fl0-at",
        "repo": "iCalStripper"
      }
    ],
    "win": {
      "publish": [
        "github"
      ],
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "snap",
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
